# Copy to .env (gitignored) and fill in. .env is the only place real values live.

# LLM — the negotiation brain (required to run a live negotiation; tests use a mock)
ANTHROPIC_API_KEY=

# Twilio telephony — ONLY needed to place a real outbound call.
# The server, transport, and offline tests need none of these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# For a safe demo, point this at YOUR OWN phone and role-play the billing rep.
TWILIO_TO_NUMBER=
# Public https URL where telephony/server.py is reachable (e.g. an ngrok URL).
PUBLIC_BASE_URL=
