# Copy to .env (gitignored) and fill in. .env is the only place real values live.

# LLM — the negotiation brain. ONLY needed here for `jac run main.jac` (the
# local mock-rep loop, which runs the whole negotiation on your machine).
# NOT needed for the live phone call (`jaul`) — that path runs entirely on
# the deployed Render server, which reads its own ANTHROPIC_API_KEY from
# Render's dashboard secret (see render.yaml), never from a local .env.
# Offline tests (`jac test ...`) use a mock and need no key either way.
ANTHROPIC_API_KEY=

# Twilio telephony — ONLY needed to place a real outbound call (`jaul` /
# telephony/dial.jac). The server, transport, and offline tests need none of these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# For a safe demo, point this at YOUR OWN phone and role-play the billing rep.
TWILIO_TO_NUMBER=
# OPTIONAL — leave unset and `jaul` dials through the deployed Render server
# by default (see telephony/dial.jac's DEFAULT_PUBLIC_BASE_URL). Set this only
# to dial through your own local server/ngrok tunnel instead.
PUBLIC_BASE_URL=

# ElevenLabs TTS — OPTIONAL. If ELEVENLABS_API_KEY is unset (or the call
# fails/times out), calls fall back to Twilio's built-in Polly voice for that
# turn. Offline tests need none of these.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: defaults to eleven_flash_v2_5 (low latency) if unset.
ELEVENLABS_MODEL_ID=
